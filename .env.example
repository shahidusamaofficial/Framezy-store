NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Required for correct canonical URLs, sitemap.xml, and Open Graph tags.
# Set this to your real deployed URL (Vercel subdomain or custom domain).
NEXT_PUBLIC_SITE_URL=https://the-wall-edit.vercel.app

# Optional — only fill these in if accurate. Leaving them blank means no
# LocalBusiness structured data is published, rather than publishing a fake
# address. See README section "Custom domain & structured data" for details.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=hello@thewalledit.pk
NEXT_PUBLIC_BUSINESS_STREET=
NEXT_PUBLIC_BUSINESS_CITY=
NEXT_PUBLIC_BUSINESS_REGION=
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
